{
  "manifest_version": 3,
  "name": "Palette",
  "description": "A command palette for Chrome. ⌘P to switch tabs, ⌘K to run commands.",
  "version": "0.1.0",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Palette",
    "default_popup": "palette.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["palette.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "commands": {
    "open-tabs": {
      "suggested_key": { "default": "Ctrl+Shift+P", "mac": "Command+Shift+P" },
      "description": "Search tabs"
    },
    "open-commands": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Run a command"
    }
  },
  "permissions": ["tabs", "favicon", "sessions", "search", "storage", "scripting", "clipboardWrite"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
